# OmniCommerce Enterprise Environment Configuration
# Copy this file to .env for local deployment

NODE_ENV=development
PORT=3000
HOST=localhost

# Application Details
APP_NAME=OmniCommerce Enterprise
APP_URL=http://localhost:3000

# Authentication & Security Placeholder Settings (No production keys included)
JWT_SECRET=omnicommerce_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=86400

# Database Storage Path (File-backed local persistence engine)
DATA_STORAGE_DIR=./data

# Payment Gateway Mock Credentials
STRIPE_MOCK_SECRET_KEY=sk_test_omnicommerce_mock_stripe_key_placeholder
PAYPAL_MOCK_CLIENT_ID=sandbox_paypal_client_id_placeholder

# System Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOGS=true
